# Lo carga Adonis encima de .env solo cuando NODE_ENV=test (`node ace test`).
# Apunta la batería de pruebas al servicio `db-test` de compose.yaml: en
# memoria, sin volumen, y en otro puerto que la base de desarrollo.
SESSION_DRIVER=memory

DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
